{
  "name": "tasks-api",
  "private": true,
  "version": "1.0.0",
  "description": "Minimal REST API (Express + MongoDB) used to practice environment variables in GitHub Actions",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "supertest": "^7.3.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.17.0"
}
