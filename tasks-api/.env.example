# Copy this file to .env and adjust the values: cp .env.example .env
# .env is gitignored, .env.example is committed.

# HTTP port of the API
PORT=3000

# MongoDB Atlas connection string (required) — Atlas UI > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to "tasks")
MONGODB_DB_NAME=tasks
